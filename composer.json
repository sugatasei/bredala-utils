{
    "name": "sugatasei/bredala-utils",
    "description": "Collection of PHP utility class",
    "license": "MIT",
    "authors": [
        {
            "name": "Mathieu Froehly",
            "email": "mathieu@sopheos.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "suggest": {
        "ext-imagick": "Required by Bredala\\Utils\\Image"
    },
    "autoload": {
        "psr-4": {
            "Bredala\\Utils\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
